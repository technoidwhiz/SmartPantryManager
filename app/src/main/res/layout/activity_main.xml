<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF7"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pantry_title"
            android:textColor="#203B2C"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pantry_description"
            android:textColor="#526158"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:backgroundTint="#276749"
            android:text="@string/add_ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <ListView
                android:id="@+id/listPantry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#DCE5DE"
                android:dividerHeight="1dp"
                android:visibility="gone"
                tools:visibility="gone" />

            <TextView
                android:id="@+id/textEmptyPantry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/empty_pantry"
                android:textColor="#526158"
                android:textSize="16sp" />

        </FrameLayout>

        <Button
            android:id="@+id/buttonSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="#276749"
            android:text="@string/suggested_recipes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/buttonSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:backgroundTint="#E2EBE5"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="#203B2C" />

    </LinearLayout>

</LinearLayout>